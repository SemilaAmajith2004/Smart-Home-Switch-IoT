%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#E3F2FD', 'edgeLabelBackground':'#FFFFFF', 'tertiaryColor': '#fff'}}}%%

graph TD
    %% --- Subgraph for User Interface ---
    subgraph UI [User Interface Layer]
        A[User Voice Command]:::ui
        D[Physical Wall Switch\n(Toggle/Push Button)]:::ui
    end

    %% --- Subgraph for Services & Logic ---
    subgraph Services [Cloud & Connectivity Layer]
        B{Google Assistant\n(NLP & Action)}:::cloud
        C{Sinric Pro\nCloud Platform}:::cloud
        
        %% Junction point for data flow to make the diagram look clean
        Hub((Data<nHub)):::logic 
    end

    %% --- Subgraph for Microcontroller ---
    subgraph MCU [Control Layer - NodeMCU ESP8266]
        E(ESP8266 Core\nFirmware Loop):::mcu
        
        %% Defining GPIO interfaces
        GPIO_In[GPIO Input\nInterface D2]:::logic
        GPIO_Out[GPIO Output\nInterface D1]:::logic
        
        %% Internal processes
        WiFi[Wi-Fi Stack\nWiFiManager]:::intern
        WebSocket[WebSocket Client\nSinricPro Lib]:::intern
    end

    %% --- Subgraph for Hardware Output ---
    subgraph Output [Hardware Layer]
        F[5V Relay Module\n(Active Low/High)]:::hard
        G[230V AC\nLight Bulb]:::hard
    end

    %% --- Connection Logic ---

    %% Voice Path
    A -->|Starts Action| B
    B -->|API Request| C
    C -->|Secure Protocol| WebSocket

    %% Cloud <-> MCU Link
    WebSocket -->|Binds Data| WiFi
    WiFi <-->|Control & Status| Hub
    Hub -->|Invokes Command| E
    E -->|Updates Status| Hub

    %% Internal MCU Connections
    E -.->|Reads| GPIO_In
    E -.->|Writes| GPIO_Out

    %% Physical Path
    D -->|Signal (Interrupt)| GPIO_In
    
    %% Output Path
    GPIO_Out -->|Control Signal| F
    F -->|High Voltage Switching| G

    %% --- Styling & Classes ---
    classDef ui fill:#D4E157,stroke:#333,stroke-width:2px,color:#000;
    classDef cloud fill:#90CAF9,stroke:#1E88E1,stroke-width:2px,color:#000,rx:5,ry:5;
    classDef mcu fill:#CE93D8,stroke:#8E24AA,stroke-width:2px,color:#000,rx:10,ry:10;
    classDef logic fill:#E0E0E0,stroke:#333,stroke-width:1px,stroke-dasharray: 5 5,color:#000,shape:circle;
    classDef intern fill:#FFF59D,stroke:#FBC02D,stroke-width:1px,color:#000;
    classDef hard fill:#EF9A9A,stroke:#E53935,stroke-width:2px,color:#000;

    %% Add labels on background if needed
    %% linkStyle 3 stroke:#1E88E1,stroke-width:2px,stroke-dasharray: 5 5;